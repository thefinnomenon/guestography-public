{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "firebase emulators:start --import=./data --export-on-exit=./data",
    "emulateScheduledFunctions": "cat ./src/emulateScheduledFunctions.sh /dev/stdin | firebase functions:shell",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "kill": "kill -9 $(lsof -ti:8080) && kill -9 $(lsof -ti:8085)",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "db:export": "firestore-export -a ../lib/serviceAccountKey.json -b ./data/firestore.json",
    "db:import": "firestore-import -a ../lib/serviceAccountKey.json -b ./data/firestore.json",
    "db:emulator:export": "export FIRESTORE_EMULATOR_HOST=localhost:8080 && yarn db:export",
    "db:emulator:import": "export FIRESTORE_EMULATOR_HOST=localhost:8080 && yarn db:import",
    "db:backup": "cp ./data/firestore.json ./data/firestore-$(date +%d-%m-%Y-%H-%M).json"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.332.0",
    "@google-cloud/tasks": "^3.1.1",
    "@google-cloud/video-transcoder": "^2.5.0",
    "@sentry/serverless": "^7",
    "@types/got": "^9.6.12",
    "child-process-promise": "^2.2.1",
    "cross-fetch": "^3.1.6",
    "dotenv": "^16.1.4",
    "exifreader": "^4.12.0",
    "file-type": "^16.5.4",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^4.6.0",
    "got": "^11.8.3",
    "image-size": "^1.0.2",
    "mediainfo.js": "^0.1.9",
    "mixpanel": "^0.17.0",
    "node-firestore-import-export": "^1.1.0",
    "plaiceholder": "^2.5.0",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.32.1"
  },
  "devDependencies": {
    "@types/async": "^3.2.18",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.0.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
